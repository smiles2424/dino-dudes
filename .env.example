# ── Dino Dudes environment ─────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The server boots without secrets; the database and cache values are needed
# for anything that persists a drawing.

# Neon Postgres — pooled connection string (app queries).
# Neon console → your project → Connect → "Pooled connection".
# Format: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Neon Postgres — direct (unpooled) connection, used only by Drizzle migrations.
# Same dialog, toggle pooling off.
DATABASE_URL_UNPOOLED=

# Upstash Redis — REST endpoint + token (v1 client: @upstash/redis over HTTPS/443).
# Upstash console → your Redis DB → REST API section. The token is the same value as the
# password inside the rediss:// URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Redis — TCP/TLS URL for ioredis. Unused in v1, kept for a possible
# multi-instance Colyseus. Blocked on dev machines whose VPN blackholes 6379.
# Format: rediss://default:PASSWORD@xxx.upstash.io:6379
REDIS_URL=

# Secret for signing lobby/player session tokens. Any random 32+ char string.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Robustness knobs (defaults are fine) ───────────────────────────────
# `POST /api/avatars` uploads allowed per minute per player (and 10x that per
# source IP, because a whole class shares one Wi-Fi NAT at the venue).
# 0 disables the limiter, which is the default under NODE_ENV=test so the E2E
# suite stays deterministic. Unset elsewhere == 12/min (burst 6).
AVATAR_UPLOAD_LIMIT_PER_MIN=

# How long a lobby may sit with nothing happening (no join, no upload) before
# the next room disposal or lobby creation stamps its `closed_at`. Default 12.
LOBBY_IDLE_HOURS=

# ── Local dev settings (defaults are fine) ─────────────────────────────
PORT=2567
# Interface the server binds. 0.0.0.0 (the default) is what a container needs;
# leave it alone unless you are binding a specific NIC.
HOST=0.0.0.0
VITE_API_URL=http://localhost:2567
VITE_WS_URL=ws://localhost:2567

# ── Deployed-only settings (see docs/DEPLOY.md) ────────────────────────
# Base URL of the WEB client. This is what the projector's QR code encodes, so
# in production it must be the address a phone can actually open (the Netlify
# site URL), not the API's.
PUBLIC_WEB_URL=http://localhost:5173

# Comma-separated CORS allowlist for the API. `*` (the default) is fine for a
# party game on a school Wi-Fi; set it to PUBLIC_WEB_URL to be strict.
CORS_ORIGIN=*

# NOTE for the client: VITE_* variables are baked into the static bundle at
# BUILD time. On Netlify they live in the site's environment variables and a
# change needs a rebuild, not a restart.
