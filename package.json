{
  "name": "dino-dudes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "turbo run build && pnpm --filter @dino/e2e run test",
    "e2e:only": "pnpm --filter @dino/e2e run test",
    "e2e:install": "pnpm --filter @dino/e2e exec playwright install --with-deps chromium",
    "validate:connections": "node scripts/validate-connections.mjs",
    "generate-template": "pnpm --filter @dino/pipeline run generate-template"
  },
  "pnpm": {
    "overrides": {
      "@colyseus/greeting-banner": "^2.0.6"
    },
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract"]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@upstash/redis": "^1.34.3",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
